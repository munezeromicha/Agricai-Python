# Copy to .env and adjust.

# Bind address for uvicorn / PM2 (production usually 0.0.0.0)
# HOST=0.0.0.0
# PORT=8000

# stub = demo | onnx = .onnx file | keras = .keras file | roboflow = hosted detection API
INFERENCE_MODE=roboflow

# Roboflow serverless — set ROBOFLOW_API_KEY in .env (never commit the real key)
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=tomato-disease-b518h/3
ROBOFLOW_CONFIDENCE_THRESHOLD=0.50
MODEL_VERSION=roboflow-tomato-disease-b518h

# Pre-inference quality gates (Roboflow path) — reject blurry/dark/bright/tiny photos
# before spending an API call. Needs real-world tuning once you have field photos.
IMAGE_QUALITY_ENABLED=true
IMAGE_QUALITY_BLUR_VARIANCE_THRESHOLD=60.0
IMAGE_QUALITY_MIN_EDGE_PX=200
IMAGE_QUALITY_MIN_MEAN_LUMA=25.0
IMAGE_QUALITY_MAX_MEAN_LUMA=235.0

# Roboflow-path margin check: reject when top-1 and top-2 predicted diseases are
# nearly tied in confidence instead of forcing a pick.
ROBOFLOW_MARGIN_THRESHOLD=0.10

# Adaptive test-time augmentation: fires a second (flipped) Roboflow call only when
# the first call's result is borderline (near the confidence floor or a close margin).
ROBOFLOW_TTA_ENABLED=true
ROBOFLOW_TTA_BAND_PCT=15.0
ROBOFLOW_TTA_MARGIN_TRIGGER_PCT=20.0

# Semantic version of the weights you deploy (shown in API responses)
MODEL_VERSION=tomato-cnn-2.0.0

# Model file — tomato-only testing:
MODEL_PATH=model/tomato_model.keras
# Multi-crop identity gate (see CROP_GATE_* below): model/archive/crop_classifier.onnx

# Knowledge base — tomato-only classes for testing:
CLASSES_PATH=data/classes_tomato.json
# Full multi-crop (backup): data/classes_multicrop.json.bak

# keras only: imagenet (MobileNet training — use this) | builtin_rescale (model has Rescaling layer)
KERAS_PREPROCESS=imagenet

# Stage 1 binary gate — tomato leaf vs not (train with training/train_tomato_gate.py)
TOMATO_GATE_ENABLED=true
TOMATO_GATE_PATH=model/tomato_leaf_gate.keras
TOMATO_GATE_THRESHOLD=0.48
# Below this on full+cropped views → hard "not tomato" (faces, maize, etc.)
TOMATO_GATE_HARD_REJECT=0.22
# Between hard_reject and threshold → still run disease model (garden photos)
TOMATO_GATE_SOFT_PASS=true
TOMATO_GATE_USE_CROPPED=true

# Stage 0 — multi-crop identity gate: local ONNX classifier checks the uploaded photo
# actually matches the selected crop before calling Roboflow (saves an API call on
# obvious mismatches, e.g. a maize leaf submitted for the cassava model).
# Covers tomato, beans, maize, mango, onion, orange, potato, tea (8/11 crops).
# Thresholds apply to the AGGREGATED per-crop probability (all of a crop's classes summed).
#   MISMATCH_THRESHOLD + MARGIN: used when the selected crop IS one of the 8 known crops.
#     Reject only if another crop clears MISMATCH_THRESHOLD and beats the selected crop's
#     own score by MARGIN.
#   UNCOVERED_THRESHOLD: used when the selected crop is coffee/cassava/banana (not in the
#     classifier). Reject only if the photo looks very strongly like one of the 8 known
#     crops. Kept high to avoid false-rejecting genuine coffee/cassava/banana leaves.
CROP_GATE_ENABLED=true
CROP_GATE_PATH=model/archive/crop_classifier.onnx
CROP_GATE_LABELS_PATH=model/class_names.json
# REJECT_UNCOVERED: gate rejection for coffee/cassava/banana. Off by default — the
# classifier has no class for these and confidently mislabels genuine cassava as "beans"
# (~0.985), so enabling it false-rejects real photos. Only turn on with a very high
# UNCOVERED_THRESHOLD if you accept that risk.
CROP_GATE_MISMATCH_THRESHOLD=0.60
CROP_GATE_MARGIN=0.25
CROP_GATE_REJECT_UNCOVERED=false
CROP_GATE_UNCOVERED_THRESHOLD=0.99

# 11-class model: reject when Not_Tomato probability is close to top disease
NOT_TOMATO_COMPETE_THRESHOLD=0.28
NOT_TOMATO_COMPETE_MARGIN=0.18

# Top softmax score must be >= this (0–1) or API returns "unknown"
# 0.58 is tuned for field photos; raise to 0.65–0.70 if you see false positives on non-leaves
CONFIDENCE_THRESHOLD=0.58

# Top class must beat second place by at least this margin (0–1), or return "unknown"
CONFIDENCE_MARGIN=0.10

# Average predictions over flipped/cropped views (helps phone-photo generalization)
TTA_ENABLED=true

# Reject uploads that do not look like close-up leaf photos (people, landscapes, terminals)
PLANT_GUARD_ENABLED=true
PLANT_GUARD_MIN_SCORE=0.42
# Second safety net: very confident model + low leaf score → unknown
OOD_LEAF_SCORE_MAX=0.50
OOD_CONFIDENCE_TRIGGER=0.85

# Crop to the largest leaf region before guard + model (helps multi-leaf / soil backgrounds)
LEAF_AUTO_CROP_ENABLED=true

# Comma-separated browser origins for CORS (Vite default below)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,https://agric-ai.com

# Input square size — must match training preprocessing if using onnx
INPUT_SIZE=224
