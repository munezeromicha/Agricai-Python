# Copy to .env and adjust.

# stub = deterministic demo (no model file). onnx = load MODEL_PATH (.onnx)
INFERENCE_MODE=stub

# Semantic version of the weights you deploy (shown in API responses)
MODEL_VERSION=0.0.0-stub

# Required when INFERENCE_MODE=onnx — must output logits [1, N] with N = len(classes.json)
# MODEL_PATH=C:\\path\\to\\model.onnx

# If max softmax probability is below this, the API returns the "unknown" knowledge entry
CONFIDENCE_THRESHOLD=0.35

# Comma-separated browser origins for CORS (Vite default below)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Input square size — must match training preprocessing if using onnx
INPUT_SIZE=224
