# Copy to .env and adjust.

# Bind address for uvicorn / PM2 (production usually 0.0.0.0)
# HOST=0.0.0.0
# PORT=8000

# stub = demo | onnx = .onnx file | keras = .keras file (tomato testing)
INFERENCE_MODE=keras

# Semantic version of the weights you deploy (shown in API responses)
MODEL_VERSION=tomato-cnn-1.0.0

# Model file — tomato-only testing:
MODEL_PATH=model/tomato_model.keras
# Legacy multi-crop ONNX (archived): model/archive/crop_classifier.onnx

# Knowledge base — tomato-only classes for testing:
CLASSES_PATH=data/classes_tomato.json
# Full multi-crop (backup): data/classes_multicrop.json.bak

# keras only: builtin_rescale (CNN with Rescaling layer) | imagenet (MobileNet training)
KERAS_PREPROCESS=builtin_rescale

# Top softmax score must be >= this (0–1) or API returns "unknown"
# 0.58 is tuned for field photos; raise to 0.65–0.70 if you see false positives on non-leaves
CONFIDENCE_THRESHOLD=0.58

# Top class must beat second place by at least this margin (0–1), or return "unknown"
CONFIDENCE_MARGIN=0.10

# Average predictions over flipped/cropped views (helps phone-photo generalization)
TTA_ENABLED=true

# Reject uploads that do not look like plant photos (terminals, documents, etc.)
PLANT_GUARD_ENABLED=true

# Comma-separated browser origins for CORS (Vite default below)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Input square size — must match training preprocessing if using onnx
INPUT_SIZE=224
